{% assign block_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .gbr-block-{{ block_id }} {
    padding: 24px 16px;
    background-color: {{ block.settings.bg_color }};
    width: 100%;
    box-sizing: border-box;
  }

  .gbr-block-container-{{ block_id }} {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 36px;
    align-items: center;
  }

  @media (max-width: 840px) {
    .gbr-block-container-{{ block_id }} {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .gbr-b-badge-{{ block_id }} {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  @media (max-width: 840px) {
    .gbr-b-badge-{{ block_id }} {
      align-items: center;
      text-align: center;
    }
  }

  .gbr-b-header-{{ block_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .gbr-b-avatar-{{ block_id }} {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
  }

  .gbr-b-avatar-ph-{{ block_id }} {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #1a73e8;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 20px;
  }

  .gbr-b-title-{{ block_id }} {
    font-size: 19px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .gbr-b-rating-row-{{ block_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .gbr-b-score-{{ block_id }} {
    font-size: 16px;
    font-weight: 700;
    color: {{ block.settings.star_color }};
  }

  .gbr-b-stars-{{ block_id }} {
    display: flex;
    gap: 2px;
  }

  .gbr-b-star-{{ block_id }} {
    width: 17px;
    height: 17px;
    fill: {{ block.settings.star_color }};
  }

  .gbr-b-count-{{ block_id }} {
    font-size: 13px;
    color: #64748b;
    margin: 0;
  }

  .gbr-b-powered-{{ block_id }} {
    font-size: 13px;
    color: #64748b;
  }

  .gbr-b-btn-{{ block_id }} {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: {{ block.settings.btn_bg_color }};
    color: #ffffff;
    padding: 8px 16px;
    border-radius: 40px;
    font-weight: 600;
    font-size: 13px;
    text-decoration: none;
    margin-top: 4px;
    box-shadow: 0 2px 8px rgba(26,115,232,0.3);
  }

  .gbr-b-card-{{ block_id }} {
    background-color: {{ block.settings.card_bg_color }};
    border-radius: 14px;
    padding: 20px;
    position: relative;
  }

  .gbr-b-card-head-{{ block_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 10px;
  }

  .gbr-b-author-{{ block_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .gbr-b-author-init-{{ block_id }} {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: #004d40;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 16px;
  }

  .gbr-b-author-name-{{ block_id }} {
    font-weight: 700;
    font-size: 15px;
    color: #1a365d;
  }

  .gbr-b-author-date-{{ block_id }} {
    font-size: 12px;
    color: #94a3b8;
  }
{% endstyle %}

<div class="gbr-block-{{ block_id }}">
  <div class="gbr-block-container-{{ block_id }}">
    
    <!-- Left summary -->
    <div class="gbr-b-badge-{{ block_id }}">
      <div class="gbr-b-header-{{ block_id }}">
        {%- if block.settings.business_image != blank -%}
          {{ block.settings.business_image | image_url: width: 100 | image_tag: class: 'gbr-b-avatar', alt: block.settings.business_name }}
        {%- else -%}
          <div class="gbr-b-avatar-ph-{{ block_id }}">
            {{ block.settings.business_name | slice: 0 | upcase }}
          </div>
        {%- endif -%}

        <h4 class="gbr-b-title-{{ block_id }}">{{ block.settings.business_name }}</h4>
      </div>

      <div class="gbr-b-rating-row-{{ block_id }}">
        <span class="gbr-b-score-{{ block_id }}">{{ block.settings.overall_rating }}</span>
        <div class="gbr-b-stars-{{ block_id }}">
          {%- for i in (1..5) -%}
            <svg class="gbr-b-star-{{ block_id }}" viewBox="0 0 24 24">
              <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
            </svg>
          {%- endfor -%}
        </div>
      </div>

      <p class="gbr-b-count-{{ block_id }}">{{ block.settings.reviews_count_text }}</p>
      
      <div class="gbr-b-powered-{{ block_id }}">
        powered by <span style="color:#4285F4;font-weight:700">G</span><span style="color:#EA4335;font-weight:700">o</span><span style="color:#FBBC05;font-weight:700">o</span><span style="color:#4285F4;font-weight:700">g</span><span style="color:#34A853;font-weight:700">l</span><span style="color:#EA4335;font-weight:700">e</span>
      </div>

      {%- if block.settings.button_link != blank or block.settings.button_text != blank -%}
        <a href="{{ block.settings.button_link | default: '#' }}" class="gbr-b-btn-{{ block_id }}" target="_blank">
          {{ block.settings.button_text }}
          <svg viewBox="0 0 24 24" width="14" height="14">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
        </a>
      {%- endif -%}
    </div>

    <!-- Review Card -->
    <div class="gbr-b-card-{{ block_id }}">
      <div class="gbr-b-card-head-{{ block_id }}">
        <div class="gbr-b-author-{{ block_id }}">
          <div class="gbr-b-author-init-{{ block_id }}">
            {{ block.settings.author_name | slice: 0 | downcase | default: 'f' }}
          </div>
          <div>
            <div class="gbr-b-author-name-{{ block_id }}">{{ block.settings.author_name }}</div>
            <div class="gbr-b-author-date-{{ block_id }}">{{ block.settings.author_date }}</div>
          </div>
        </div>
        <svg viewBox="0 0 24 24" width="20" height="20">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
      </div>

      <div class="gbr-b-stars-{{ block_id }}" style="margin-bottom: 8px;">
        {%- for i in (1..5) -%}
          <svg class="gbr-b-star-{{ block_id }}" viewBox="0 0 24 24">
            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
          </svg>
        {%- endfor -%}
      </div>

      <p style="margin:0; font-size:14px; color:#334155; line-height:1.4;">{{ block.settings.review_text }}</p>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Google Business Review",
  "settings": [
    {
      "type": "text",
      "id": "business_name",
      "label": "Business Name",
      "default": "Pixelrigz"
    },
    {
      "type": "image_picker",
      "id": "business_image",
      "label": "Business Logo"
    },
    {
      "type": "text",
      "id": "overall_rating",
      "label": "Overall Rating",
      "default": "5.0"
    },
    {
      "type": "text",
      "id": "reviews_count_text",
      "label": "Reviews Text",
      "default": "Based on 3 reviews"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "review us on"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Google Review URL"
    },
    {
      "type": "text",
      "id": "author_name",
      "label": "Review Author Name",
      "default": "farooq khan"
    },
    {
      "type": "text",
      "id": "author_date",
      "label": "Review Time",
      "default": "14 days ago"
    },
    {
      "type": "textarea",
      "id": "review_text",
      "label": "Review Text",
      "default": "They made customize PC for me and it's best."
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#ff8c00"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Color",
      "default": "#1a73e8"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#101828"
    }
  ],
  "presets": [
    {
      "name": "Google Business Review"
    }
  ]
}
{% endschema %}
